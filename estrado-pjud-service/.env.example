API_KEY=your-secret-api-key-here
OJV_BASE_URL=https://oficinajudicialvirtual.pjud.cl
RATE_LIMIT_MS=2500
LOG_LEVEL=INFO
SESSION_POOL_SIZE=2
SESSION_MAX_AGE_S=1200
COOKIE_STORE_PATH=/var/lib/estrado-pjud/cookies.json

# Telegram alerts
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_BLOCKED_RATE_THRESHOLD=0.3
TELEGRAM_COOLDOWN_S=300

# Worker config
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
WORKER_ID=vps-worker-1
POOL_SIZE=1
BATCH_SIZE=10
HEARTBEAT_INTERVAL_S=60
OJV_TIMEOUT_S=25
PJUD_BASE_URL=https://oficinajudicialvirtual.pjud.cl
# Canary del worker: apagado conserva SESSION_MAX_AGE_S sin validaciones nuevas.
WORKER_SESSION_REUSE_VALIDATION_ENABLED=false
# UTC estable del inicio del canary. Es obligatorio antes de activar el flag.
SESSION_REUSE_ROLLOUT_STARTED_AT=
# Revalidar desde 20 min; retirar antes de 50 min o del techo sticky efectivo.
SESSION_SOFT_VERIFY_AGE_S=1200
SESSION_HARD_MAX_AGE_S=3000
SESSION_STICKY_SAFETY_MARGIN_S=600
MINT_MAX_RETRIES=3
MINT_TRAFFIC_BUDGET_S=35
BLOCK_PAUSE_S=30
# Override temporal de marcha blanca; volver a false para restaurar horario hábil.
PJUD_PROCESS_OUTSIDE_OFFICE_HOURS=false
# Both web and worker must be true before any Mis Causas job is created/claimed.
ENABLE_PJUD_MY_CAUSES_IMPORT=false
# Undocumented optimizer: intentionally unsupported and rejected if set true.
ENABLE_PJUD_MY_CAUSES_EXCEL=false
VERCEL_APP_URL=https://juristrack.example
INTERNAL_CREDENTIALS_API_KEY=your-internal-api-key

# Proxy residencial. Nunca commitear el valor real de OJV_PROXY_URL.
# Mantener el worker detenido si falta cualquiera de las variables Supabase,
# el circuito persistente o un presupuesto global activo.
OJV_PROXY_URL=http://username:password@proxy.example:12321
OJV_PROXY_STICKY_LIFETIME=1h
OJV_PROXY_POOL_SIZE=1
OJV_PROXY_GB_BUDGET=2.0
OJV_PROXY_GB_ALERT_PCT=80
OJV_PROXY_PRICE_PER_GB_USD=6.25

# R2 document storage
R2_ENABLED=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=estrado-documents
