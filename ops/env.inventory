# Inventario de variables del .env del microservicio en el VPS
# (/opt/legal-tech-microservices/estrado-pjud-service/.env,
#  modo 0640, owner root, grupo estrado: API y worker deben poder leerlo).
#
# SOLO NOMBRES. Los valores viven únicamente en el VPS y jamás en git.
# provision.sh usa esta lista para decir QUÉ falta al reconstruir la máquina;
# los valores hay que reponerlos desde el gestor de secretos / dashboards.
#
# Snapshot del 2026-08-04. Si config.py agrega una variable, agregala acá:
# es lo que hace que una reconstrucción no descubra el faltante en runtime.
API_KEY
BATCH_SIZE
BLOCK_PAUSE_S
COOKIE_STORE_PATH
HEARTBEAT_INTERVAL_S
ENABLE_PJUD_MY_CAUSES_EXCEL
ENABLE_PJUD_MY_CAUSES_IMPORT
ENABLE_PJUD_PRIVATE_FAMILIA
INTERNAL_CREDENTIALS_API_KEY
LOG_LEVEL
MINT_MAX_RETRIES
MINT_TRAFFIC_BUDGET_S
OJV_BASE_URL
OJV_PROXY_GB_ALERT_PCT
OJV_PROXY_GB_BUDGET
OJV_PROXY_POOL_SIZE
OJV_PROXY_PRICE_PER_GB_USD
OJV_PROXY_STICKY_LIFETIME
OJV_PROXY_URL
OJV_TIMEOUT_S
PJUD_BASE_URL
PJUD_PROCESS_OUTSIDE_OFFICE_HOURS
POOL_SIZE
RATE_LIMIT_MS
R2_ACCESS_KEY_ID
R2_BUCKET
R2_ENABLED
R2_ENDPOINT
R2_SECRET_ACCESS_KEY
SESSION_HARD_MAX_AGE_S
SESSION_MAX_AGE_S
SESSION_REUSE_ROLLOUT_STARTED_AT
SESSION_POOL_SIZE
SESSION_SOFT_VERIFY_AGE_S
SESSION_STICKY_SAFETY_MARGIN_S
SUPABASE_SERVICE_KEY
SUPABASE_URL
# Del bot de Hermes (pareado, no configurado por env): el token vive en
# /home/hermes/.hermes/.env y el chat id sale de TELEGRAM_ALLOWED_USERS —
# la misma extracción que hace estrado-watchdog.sh. Sin estas dos, el
# TelegramAlerter del micro arranca en None y NO alerta: estuvo así desde
# siempre y nadie se enteró, que es exactamente lo que este inventario
# existe para impedir.
TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID
TELEGRAM_BLOCKED_RATE_THRESHOLD
TELEGRAM_COOLDOWN_S
VERCEL_APP_URL
WORKER_ID
WORKER_SESSION_REUSE_VALIDATION_ENABLED
