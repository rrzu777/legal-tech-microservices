# Inventario de variables del .env del microservicio en el VPS
# (/opt/legal-tech-microservices/estrado-pjud-service/.env, modo 600).
#
# SOLO NOMBRES. Los valores viven únicamente en el VPS y jamás en git.
# provision.sh usa esta lista para decir QUÉ falta al reconstruir la máquina;
# los valores hay que reponerlos desde el gestor de secretos / dashboards.
#
# Snapshot del 2026-08-04. Si config.py agrega una variable, agregala acá:
# es lo que hace que una reconstrucción no descubra el faltante en runtime.
API_KEY
COOKIE_STORE_PATH
INTERNAL_CREDENTIALS_API_KEY
LOG_LEVEL
OJV_BASE_URL
OJV_PROXY_GB_BUDGET
OJV_PROXY_POOL_SIZE
OJV_PROXY_URL
POOL_SIZE
RATE_LIMIT_MS
R2_ENABLED
SUPABASE_SERVICE_KEY
SUPABASE_URL
# Del bot de Hermes (pareado, no configurado por env): el token vive en
# /home/hermes/.hermes/.env y el chat id sale de TELEGRAM_ALLOWED_USERS —
# la misma extracción que hace estrado-watchdog.sh. Sin estas dos, el
# TelegramAlerter del micro arranca en None y NO alerta: estuvo así desde
# siempre y nadie se enteró, que es exactamente lo que este inventario
# existe para impedir.
TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID
VERCEL_APP_URL
WORKER_ID
