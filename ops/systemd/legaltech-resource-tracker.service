[Unit]
Description=LegalTech Resource Tracker
After=network-online.target estrado-pjud.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/legaltech-monitoring
ExecStart=/usr/bin/python3 /opt/legaltech-monitoring/resource-tracker.py --once

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/legaltech/resources.csv
RestrictAddressFamilies=AF_UNIX

MemoryMax=128M
CPUQuota=20%
TasksMax=64
Slice=system.slice

StandardOutput=journal
StandardError=journal
SyslogIdentifier=legaltech-resource-tracker
