[Unit]
Description=LegalTech Critical Monitor
After=network-online.target estrado-pjud.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/legaltech-monitoring
EnvironmentFile=-/etc/legaltech-monitoring.env
ExecStart=/usr/bin/python3 /opt/legaltech-monitoring/monitor.py --once

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=legaltech-monitor
StateDirectoryMode=0750
LogsDirectory=legaltech
LogsDirectoryMode=0750
ReadWritePaths=/var/lib/legaltech-monitor /var/log/legaltech

MemoryMax=128M
CPUQuota=20%
TasksMax=64
Slice=system.slice

StandardOutput=journal
StandardError=journal
SyslogIdentifier=legaltech-monitor
