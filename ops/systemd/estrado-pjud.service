[Unit]
Description=Estrado PJUD Scraper Service (HIGH PRIORITY)
After=network.target
PartOf=legaltech.slice

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/legal-tech-microservices/estrado-pjud-service

Environment=PATH=/opt/legal-tech-microservices/estrado-pjud-service/.venv/bin
EnvironmentFile=/opt/legal-tech-microservices/estrado-pjud-service/.env

# Solo localhost: el único que entra es Caddy (443, TLS) — ops/caddy/README.md.
# --proxy-headers sin --forwarded-allow-ips es inerte: uvicorn ignora los
# X-Forwarded-* de un peer no confiable, y el journal loguearía 127.0.0.1 como
# cliente de TODO request. La medición de scanners que justificó este cutover
# salió justamente de esas IPs, así que perderlas es perder el instrumento.
ExecStart=/opt/legal-tech-microservices/estrado-pjud-service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1

Slice=legaltech.slice

MemoryMax=4294967296
MemoryHigh=3221225472
CPUQuota=200%
CPUWeight=500

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=estrado-pjud

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/legal-tech-microservices/estrado-pjud-service

[Install]
WantedBy=multi-user.target
