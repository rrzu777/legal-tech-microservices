[Unit]
Description=Estrado PJUD Scraper Service (HIGH PRIORITY)
After=network.target
PartOf=legaltech.slice

[Service]
Type=simple
User=www-data
Group=estrado
StateDirectory=estrado-pjud
StateDirectoryMode=0770
RuntimeDirectory=estrado-pjud-api
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/legal-tech-microservices/estrado-pjud-service

Environment=PATH=/opt/legal-tech-microservices/estrado-pjud-service/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
Environment=HOME=/run/estrado-pjud-api
Environment=TMPDIR=/run/estrado-pjud-api
EnvironmentFile=/opt/legal-tech-microservices/estrado-pjud-service/.env

# Solo localhost: el único que entra es Caddy (443, TLS) — ops/caddy/README.md.
#
# Los dos flags de proxy son EXPLÍCITOS, no correctivos: uvicorn 0.41 ya trae
# proxy_headers=True y forwarded_allow_ips resuelto a "127.0.0.1", así que sin
# ellos el comportamiento sería el mismo. Van escritos porque de eso depende
# que request.client.host sea la IP real del cliente y no la de Caddy, y de
# ahí salen dos cosas: la clave del rate limiting (app/rate_limit.py usa
# get_remote_address) y la IP que loguea el journal —el instrumento con el que
# se midió que el 100% del tráfico externo del 8000 eran scanners—. El default
# de forwarded_allow_ips además lo pisa la env FORWARDED_ALLOW_IPS, y este
# unit carga un EnvironmentFile: escribirlo acá lo deja fuera de ese alcance.
# El worker automático y el API interactivo comparten el mismo CookieMinter:
# Chromium debe correr headed para superar F5. Xvfb permite ese mint desde una
# acción 24/7 sin encender el worker programado. PrivateTmp da a Xvfb su socket
# Unix escribible; TMPDIR mantiene los artefactos de Playwright en el runtime.
ExecStart=/usr/bin/xvfb-run -a /opt/legal-tech-microservices/estrado-pjud-service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1

Slice=legaltech.slice

MemoryMax=4294967296
MemoryHigh=3221225472
CPUQuota=200%
CPUWeight=500

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=estrado-pjud

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/opt/legal-tech-microservices/estrado-pjud-service

[Install]
WantedBy=multi-user.target
